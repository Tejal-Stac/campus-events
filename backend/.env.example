# Database Configuration
# For Neon/Supabase Cloud PostgreSQL

# Method 1: Individual connection parameters
DB_HOST=your-project.neon.tech
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# JWT Secret (use a strong random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Port
PORT=5000

# ===== NEON EXAMPLE =====
# DB_HOST=ep-cool-darkness-123456.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=npg_aBcDeFgHiJkLmNoPqRsTuVwXyZ123456

# ===== SUPABASE EXAMPLE =====
# DB_HOST=db.abcdefghijklmnop.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.abcdefghijklmnop
# DB_PASSWORD=your_supabase_password

# ===== LOCAL POSTGRESQL =====
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=campus_events
# DB_USER=postgres
# DB_PASSWORD=your_local_password
